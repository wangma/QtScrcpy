+
+QPointF InputConvertBase::displayDeltaToScreenDelta(const QPointF &delta) const
+{
+    // VideoForm::mapInputPos 的逆变换：
+    //   90° -> mapped(x, y) = (sy, w - sx)  =>  dx = -dy_mapped, dy = dx_mapped
+    //  180° -> mapped(x, y) = (w - sx, h - sy)
+    //  270° -> mapped(x, y) = (h - sy, sx) =>  dx = dy_mapped, dy = -dx_mapped
+    QPointF screenDelta = delta;
+    switch (m_displayRotation) {
+    case 90:
+        screenDelta = QPointF(-delta.y(), delta.x());
+        break;
+    case 180:
+        screenDelta = QPointF(-delta.x(), -delta.y());
+        break;
+    case 270:
+        screenDelta = QPointF(delta.y(), -delta.x());
+        break;
+    default:
+        break;
+    }
+    return screenDelta;
+}
